<!--
  Merge these into android/app/src/main/AndroidManifest.xml AFTER running
  `npx cap add android`.

  1. Add the permissions inside <manifest>, above <application>.
  2. Add the <service> block INSIDE <application>, alongside the auto-generated
     .MainActivity <activity>.
-->

<!-- permissions -->
<uses-permission android:name="android.permission.INTERNET" />
<uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
<!-- BIND_NOTIFICATION_LISTENER_SERVICE must be requested by the <service>, not <uses-permission>. -->

<!-- inside <application> ... </application> -->
<service
    android:name=".notifications.NotificationCaptureService"
    android:label="Finance Flow Pocket - Detección"
    android:exported="true"
    android:permission="android.permission.BIND_NOTIFICATION_LISTENER_SERVICE">
    <intent-filter>
        <action android:name="android.service.notification.NotificationListenerService" />
    </intent-filter>
</service>
